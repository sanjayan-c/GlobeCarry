                                android:src="@drawable/img_airplane_takeoff" />

                            <TextView
                                android:id="@+id/txtDeparted"
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="24dp"
                                android:layout_weight="0.69"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Departed From The Country" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearAssetElement2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/linearAssetElement1"
                            android:layout_marginTop="160dp"
                            android:layout_marginEnd="10dp"
                            android:gravity="start"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnLanded"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/rectangle_bg_white"
                                android:paddingHorizontal="11dp"
                                android:paddingVertical="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/img_airplane_land" />

                            <TextView
                                android:id="@+id/txtLanded"
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="24dp"
                                android:layout_weight="0.69"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Reached The Destination" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearAssetElement3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/linearAssetElement2"
                            android:layout_marginTop="210dp"
                            android:layout_marginEnd="10dp"
                            android:gravity="start"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnReceived"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/rectangle_bg_white"
                                android:paddingHorizontal="11dp"
                                android:paddingVertical="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/baseline_card_giftcard_24" />

                            <TextView
                                android:id="@+id/txtReceived"
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="24dp"
                                android:layout_weight="0.69"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Received" />
                        </LinearLayout>

                    </FrameLayout>

                    <LinearLayout android:id="@+id/linearColumnpayNow"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="151dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="0.35"
                    android:layout_width="0dp" android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatButton
                        android:ellipsize="end" android:gravity="center"
                        android:id="@+id/btnPayNow"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_weight="5"
                        android:singleLine="true"
                        android:text="Pay Now"
                        android:layout_marginEnd="10dp"
                        android:textAllCaps="false"
                        android:background="@drawable/hint_profile_update"
                        style="@style/cusbtnSolidRoundedOutline"/>

                </LinearLayout>
                </LinearLayout>


            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>