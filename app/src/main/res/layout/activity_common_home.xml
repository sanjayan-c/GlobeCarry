<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CommonHome">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/commonHomeConstraint1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".CommonHome">

        <include layout="@layout/custom_toolbar"
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/cusTransactionMethodFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:layout_constraintBottom_toTopOf="@+id/commonHomeBottomFragmentsLayout"
            tools:ignore="MissingConstraints" />

        <LinearLayout android:id="@+id/linearRowsend"
            android:layout_gravity="end"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:padding="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@+id/commonHomeBottomFragmentsLayout"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            style="@style/usergroupStyleamber_300cornerRadius">
            <ImageView android:id="@+id/imageSend"
                android:layout_height="25dp"
                android:layout_width="25dp"
                android:scaleType="fitXY"
                android:layout_gravity="center"
                android:src="@drawable/img_home_send"
                tools:ignore="ContentDescription"/>
            <TextView android:ellipsize="end"
                android:id="@+id/txt003590077380603Four"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:text="Parcel"
                style="@style/usertxtPoppinsbold14"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commonHomeBottomFragmentsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/commonHomeConstraint1"
            tools:ignore="MissingConstraints">
            <LinearLayout
                android:id="@+id/linearNavbarItem1"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/imageFolder1"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/my_parcels_img"
                    tools:ignore="ContentDescription"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/txtMyparcels"
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:text="My Deliveries"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/linearNavbarItem2"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/imageFolder2"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_img"
                    tools:ignore="ContentDescription"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/txtHome"
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:text="Home"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/linearNavbarItem3"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:layout_width="0dp"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/imageFolder3"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:src="@drawable/my_deliveries_img"
                    tools:ignore="ContentDescription"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
                <TextView
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/txtMyDeliveries"
                    android:layout_height="match_parent"
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:text="My Parcels"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>