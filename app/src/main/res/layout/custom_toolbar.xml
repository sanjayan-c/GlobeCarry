<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    app:popupTheme="@style/ThemeOverlay.MyPopupTheme"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_bar_background"
    app:contentInsetStart="0dp"
    app:contentInsetEnd="0dp"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginVertical="20dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="10"
                android:layout_height="wrap_content"
                android:text="𝐆𝐥𝐨𝐛𝐞𝐂𝐚𝐫𝐫𝐲"
                android:textColor="@color/black"
                android:textSize="36sp" />
            <TextView
                android:id="@+id/countMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20"
                android:visibility="gone"
                android:padding="5dp"
                android:background="@color/red"
                android:layout_marginEnd="-5dp"
                android:textColor="@color/white"
                android:textSize="14sp" />
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/profile_place_holder"
                android:layout_gravity="end"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/toolBarSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:visibility="gone"
            android:background="@drawable/search_tool_bar"
            android:layout_marginHorizontal="30dp">
            <EditText
                android:id="@+id/searchBarText"
                android:layout_width="0dp"
                android:layout_weight="10"
                android:gravity="start"
                android:paddingHorizontal="10dp"
                android:layout_height="match_parent"
                android:hint="Search"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:paddingHorizontal="5dp"
                android:layout_margin="5dp"
                android:layout_height="match_parent"
                android:background="@color/appcolour"
                android:src="@drawable/search_item_tool_bar"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:paddingHorizontal="10dp"
                android:layout_height="match_parent"
                android:src="@drawable/filter_tool_bar"/>
        </LinearLayout>
    </LinearLayout>
</androidx.appcompat.widget.Toolbar>
