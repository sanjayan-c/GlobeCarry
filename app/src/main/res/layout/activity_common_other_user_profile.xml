<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CommonUserProfile"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/commonHomeConstraint1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            tools:context=".CommonUserProfile">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include layout="@layout/custom_toolbar"
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
                <RelativeLayout
                    android:layout_below="@+id/toolbar"
                    android:id="@+id/cusAccManagementHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/cusAccManagementBack"
                        android:layout_height="30dp"
                        android:layout_width="30dp"
                        android:scaleType="fitXY"
                        tools:ignore="ContentDescription"
                        android:src="@drawable/baseline_arrow_circle_left_24" />

                    <TextView
                        style="@style/txtPoppinsmedium12_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Account Management"
                        android:textSize="18sp" />
                </RelativeLayout>
                <androidx.cardview.widget.CardView
                    android:id="@+id/commentFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    app:cardElevation="20dp"
                    android:layout_below="@+id/cusAccManagementHeading"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_centerHorizontal="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ratings : "
                                android:textSize="16sp"
                                android:gravity="center_vertical"
                                android:layout_gravity="center"/>
                            <!-- RatingBar for user rating input -->
                            <RatingBar
                                android:id="@+id/ratingBarInput"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:max="5"
                                android:rating="0"
                                android:stepSize="0.5"
                                android:scaleX="0.5"
                                android:scaleY="0.5"
                                android:progressTint="@color/appcolour"
                                android:progressTintMode="src_atop"
                                android:gravity="center"
                                android:layout_gravity="end" />
                        </LinearLayout>
                        <!-- EditText for user comments -->
                        <EditText
                            android:id="@+id/commentEditTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="100dp"
                            android:textSize="16sp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:hint="Enter your comments..."
                            android:gravity="top" />
                        <Button
                            android:id="@+id/updateReview"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="5dp"
                            android:text="Update"
                            android:background="@drawable/cus_button_update"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editableProfile"
                    app:cardElevation="20dp"
                    android:layout_below="@+id/commentFrame"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp">
                        <LinearLayout
                            android:id="@+id/cusMyBookingArrowLayout"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/cusMyBookingArrowUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="horizontal"
                            android:paddingVertical="10dp">

                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center_horizontal"
                                android:text="Profile"
                                android:textSize="20sp" />
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyBookingArrowUp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="5dp"
                                android:layout_width="wrap_content"
                                android:paddingHorizontal="20dp"
                                android:layout_centerVertical="true"
                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/cusMyBookingArrowDownLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="10dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Profile"
                                android:layout_centerInParent="true"
                                style="@style/custxtOpenSansromanbold20"
                                android:textSize="20sp"
                                android:layout_gravity="center_horizontal" />
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyBookingArrowDown"
                                android:layout_height="30dp"
                                android:rotation="180"
                                android:layout_marginEnd="6dp"
                                android:layout_centerVertical="true"
                                android:layout_width="wrap_content"
                                android:paddingHorizontal="20dp"                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/black"
                                android:layout_marginHorizontal="10dp"/>
                    <LinearLayout
                        android:id="@+id/profileContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">


                        <androidx.cardview.widget.CardView
                            android:id="@+id/cusAccountProfileImageFrame"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            app:cardElevation="20dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp">

                            <ImageView
                                android:id="@+id/cusAccountProfileImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/cus_image_not_found"
                                android:contentDescription="Profile Image" />

                            <FrameLayout
                                android:id="@+id/cusAccountProfileImageEditFrame"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#4DCCCCCC"
                                android:visibility="gone">
                                <Button
                                    android:id="@+id/cusAccManageButton1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="50dp"
                                    android:text="Change Image" />
                                <Button
                                    android:id="@+id/cusAccManageButton2"
                                    android:layout_width="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_height="50dp"
                                    android:layout_marginTop="100dp"
                                    android:text="Remove Image" />
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>



                        <LinearLayout
                            android:id="@+id/cusAccountFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="First Name"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/editTextFirstName2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:hint="-"
                                android:gravity="center_vertical"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cusAccountLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Last Name"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/viewInputLastName2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:hint="-"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:gravity="center_vertical"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cusAccountNIC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/cusAccountLastName"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="NIC"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/viewInputNIC2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:hint="-"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:gravity="center_vertical"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/cusAccountPhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Phone No"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/viewInputPhoneNo2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:hint="-"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/cusAccountAddressLine1Layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:layout_marginTop="5dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Address"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.7"
                                android:orientation="vertical">
                            <TextView
                                android:id="@+id/cusAccountAddressLine11"
                                android:layout_height="40dp"
                                android:layout_width="match_parent"
                                android:layout_marginTop="5dp"
                                android:textSize="16sp"
                                android:paddingStart="15dp"
                                android:hint="-"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/cusAccountAddressLine22"
                                android:layout_height="40dp"
                                android:layout_width="match_parent"
                                android:layout_marginTop="5dp"
                                android:textSize="16sp"
                                android:hint="-"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/cusAccountAddressLine33"
                                android:layout_height="40dp"
                                android:layout_width="match_parent"
                                android:layout_marginTop="5dp"
                                android:textSize="16sp"
                                android:hint="-"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/cusAccountCityLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="City"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/cusAccountCity2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:hint="-"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/cusAccountPostalCodeLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Postal Code"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/cusAccountPostalCode2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:hint="-"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/cusAccountCountryLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="20dp"
                            android:layout_marginEnd="20dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="0.3"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Country"
                                android:textSize="16sp"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/cusAccountCountry2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textSize="16sp"
                                android:paddingStart="15dp"
                                android:hint="-"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                        </LinearLayout>
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="20dp"
                    android:layout_below="@+id/editableProfile"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="40dp">
                    <LinearLayout
                        android:id="@+id/cusMyHistoryArrowLayout"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/cusMyHistoryArrowUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="horizontal"
                            android:paddingVertical="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="History"
                                android:layout_centerInParent="true"
                                style="@style/custxtOpenSansromanbold20"
                                android:textSize="20sp"
                                android:layout_gravity="center_horizontal" />
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyHistoryArrowUp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="5dp"
                                android:layout_width="wrap_content"
                                android:paddingHorizontal="20dp"                                android:layout_centerVertical="true"
                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/cusMyHistoryArrowDownLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="10dp"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center_horizontal"
                                android:text="History"
                                android:textSize="20sp" />
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyHistoryArrowDown"
                                android:layout_height="30dp"
                                android:rotation="180"
                                android:layout_marginEnd="8dp"
                                android:layout_centerVertical="true"
                                android:layout_width="wrap_content"
                                android:paddingHorizontal="20dp"                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/black"
                            android:layout_marginHorizontal="10dp"/>
                        <LinearLayout
                            android:id="@+id/myHistoryContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="20dp"
                                android:orientation="vertical"
                                android:layout_below="@+id/editableProfile">
                                <LinearLayout
                                    android:id="@+id/cusAccountGmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Gmail"
                                        android:textSize="16sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputGmail"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.8"
                                        android:hint="Your E-Mail"
                                        android:textSize="16sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusAccountCreated"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Signed up"
                                        android:textSize="16sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputAccountCreated"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.8"
                                        android:textSize="16sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusMyParcelsCount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="0.6"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Sent parcels"
                                        android:textSize="16sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputcusMyParcelsCount"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.4"
                                        android:hint="0"
                                        android:textSize="16sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusDeliveryCount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="0.6"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Delivered Parcels"
                                        android:textSize="16sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputDeliveryCount"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.4"
                                        android:hint="0"
                                        android:textSize="16sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusMyRatings"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="40dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:layout_gravity="center_vertical"
                                        android:singleLine="true"
                                        android:text="Ratings"
                                        android:textSize="16sp"
                                        android:gravity="center_vertical"/>
                                    <RatingBar
                                        android:id="@+id/ratingBar"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:max="5"
                                        android:rating="0"
                                        android:stepSize="0.5"
                                        android:scaleX="0.5"
                                        android:scaleY="0.5"
                                        android:progressTint="@color/appcolour"
                                        android:progressTintMode="src_atop"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusMyComments"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Comments"
                                        android:textSize="16sp"
                                        android:gravity="center_vertical"/>
                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/commentsRecyclerView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clipToPadding="false"
                                        android:scrollbars="none"
                                        android:layout_gravity="center_vertical"
                                        android:overScrollMode="never"
                                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                        tools:listitem="@layout/comment_item" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Add a ProgressBar for the loading screen -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:visibility="gone"
                    android:background="#80000000"
                    android:id="@+id/loadingAccManProgressBarLayout">
                    <ProgressBar
                        android:id="@+id/loadingAccManProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_centerInParent="true" />
                </FrameLayout>
            </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>