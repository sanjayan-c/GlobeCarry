<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CommonUserProfile"
    android:background="@color/appextracolourlight">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/commonHomeConstraint1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:id="@+id/cusAccManagementHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="15dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/app_bar_background">

                    <ImageView
                        android:id="@+id/cusAccManagementBack"
                        android:layout_height="40dp"
                        android:layout_width="40dp"
                        android:scaleType="fitXY"
                        tools:ignore="ContentDescription"
                        android:rotation="270"
                        android:src="@drawable/back_img_arrow" />

                    <TextView
                        style="@style/custxtOpenSansromanbold20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Account Management"
                        android:textSize="25dp" />
                </RelativeLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/editableProfile"
                    app:cardElevation="20dp"
                    android:layout_below="@+id/cusAccManagementHeading"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="50dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="@color/appextracolourlight">
                        <LinearLayout
                            android:id="@+id/cusMyBookingArrowLayout"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/cusMyBookingArrowUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Profile"
                                android:layout_centerInParent="true"
                                style="@style/custxtOpenSansromanbold20"
                                android:textSize="20sp"
                                android:layout_gravity="center_horizontal"
                                android:paddingTop="10dp"/>
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyBookingArrowUp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="5dp"
                                android:paddingTop="5dp"
                                android:layout_width="30dp"
                                android:layout_centerVertical="true"
                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/cusMyBookingArrowDownLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Profile"
                                android:layout_centerInParent="true"
                                style="@style/custxtOpenSansromanbold20"
                                android:textSize="20sp"
                                android:layout_gravity="center_horizontal"
                                android:paddingTop="10dp"/>
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyBookingArrowDown"
                                android:layout_height="30dp"
                                android:rotation="180"
                                android:layout_centerVertical="true"
                                android:paddingTop="5dp"
                                android:layout_marginEnd="10dp"
                                android:layout_width="30dp"
                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>


                    <LinearLayout
                        android:id="@+id/profilwContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <androidx.cardview.widget.CardView
                            android:id="@+id/cusAccountProfileImageFrame"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            app:cardElevation="20dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:backgroundTint="@color/appcolourlight">

                            <ImageView
                                android:id="@+id/cusAccountProfileImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/cus_image_not_found"
                                android:contentDescription="Profile Image" />

                            <FrameLayout
                                android:id="@+id/cusAccountProfileImageEditFrame"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#4DCCCCCC"
                                android:visibility="gone">
                                <Button
                                    android:id="@+id/cusAccManageButton1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="50dp"
                                    android:text="Change Image" />
                                <Button
                                    android:id="@+id/cusAccManageButton2"
                                    android:layout_width="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_height="50dp"
                                    android:layout_marginTop="100dp"
                                    android:text="Remove Image" />
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>



                        <LinearLayout
                            android:id="@+id/cusAccountFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="5dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="0.4"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="First Name"
                                android:textSize="18sp"
                                android:gravity="center_vertical"/>
                            <EditText
                                android:visibility="gone"
                                android:background="@drawable/cus_profile_inputbox_border"
                                android:id="@+id/editTextFirstName"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="Your First Name"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/editTextFirstName2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="Your First Name"
                                android:textSize="18sp"
                                android:gravity="center_vertical"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cusAccountLastName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="5dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="0.4"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Last Name"
                                android:textSize="18sp"
                                android:gravity="center_vertical"/>
                            <EditText
                                android:background="@drawable/cus_profile_inputbox_border"
                                android:id="@+id/viewInputLastName"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="Your Last Name"
                                android:visibility="gone"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/viewInputLastName2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="Your Last Name"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:gravity="center_vertical"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cusAccountNIC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/cusAccountLastName"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="5dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="0.4"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="NIC"
                                android:textSize="18sp"
                                android:gravity="center_vertical"/>
                            <EditText
                                android:background="@drawable/cus_profile_inputbox_border"
                                android:id="@+id/viewInputNIC"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="199931100783"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:visibility="gone"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/viewInputNIC2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="199931100783"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:gravity="center_vertical"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/cusAccountPhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="5dp">
                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="0.4"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="Phone No"
                                android:textSize="18sp"
                                android:gravity="center_vertical"/>
                            <EditText
                                android:background="@drawable/cus_profile_inputbox_border"
                                android:id="@+id/viewInputPhoneNo"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="199931100783"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:visibility="gone"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:id="@+id/viewInputPhoneNo2"
                                android:layout_height="40dp"
                                android:layout_width="0dp"
                                android:layout_weight="0.6"
                                android:hint="199931100783"
                                android:textSize="18sp"
                                android:paddingStart="15dp"
                                android:paddingEnd="15dp"
                                android:textColorHint="@color/black"
                                android:inputType="text"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:layout_centerInParent="true"
                                android:layout_margin="10dp"
                                android:layout_marginVertical="20dp"
                                android:src="@drawable/edit_profile" />

                            <LinearLayout
                                android:id="@+id/cusAccountButtons"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:visibility="gone"
                                android:layout_marginVertical="20dp"
                                android:layout_centerHorizontal="true">
                                <androidx.appcompat.widget.AppCompatButton
                                    android:ellipsize="end" android:gravity="center"
                                    android:id="@+id/btnCusUpdate"
                                    android:layout_height="50dp"
                                    android:layout_width="100dp"
                                    android:singleLine="true"
                                    android:text="Update"
                                    android:layout_marginEnd="10dp"
                                    android:textAllCaps="false"
                                    style="@style/cusbtnSolidRoundedOutline"/>
                                <androidx.appcompat.widget.AppCompatButton
                                    android:ellipsize="end" android:gravity="center"
                                    android:id="@+id/btnCusCancel"
                                    android:layout_height="50dp"
                                    android:layout_width="100dp"
                                    android:singleLine="true"
                                    android:text="Cancel"
                                    android:layout_marginStart="10dp"
                                    android:textAllCaps="false"
                                    style="@style/cusbtnSolidRoundedOutline_1"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>
                        </LinearLayout>
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="20dp"
                    android:layout_below="@+id/editableProfile"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="@color/appextracolourlight">
                    <LinearLayout
                        android:id="@+id/cusMyHistoryArrowLayout"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/cusMyHistoryArrowUpLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/custxtOpenSansromanbold20"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center_horizontal"
                                android:paddingTop="10dp"
                                android:text="My History"
                                android:textSize="20sp" />
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyHistoryArrowUp"
                                android:layout_height="30dp"
                                android:layout_marginEnd="5dp"
                                android:paddingTop="5dp"
                                android:layout_width="30dp"
                                android:layout_centerVertical="true"
                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/cusMyHistoryArrowDownLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Profile"
                                android:layout_centerInParent="true"
                                style="@style/custxtOpenSansromanbold20"
                                android:textSize="20sp"
                                android:layout_gravity="center_horizontal"
                                android:paddingTop="10dp"/>
                            <ImageView
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/cusMyHistoryArrowDown"
                                android:layout_height="30dp"
                                android:rotation="180"
                                android:layout_centerVertical="true"
                                android:paddingTop="5dp"
                                android:layout_marginEnd="10dp"
                                android:layout_width="30dp"
                                android:src="@drawable/cus_mybookings_expand_arrow" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/myHistoryContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="20dp"
                                android:orientation="vertical"
                                android:layout_below="@+id/editableProfile">
                                <LinearLayout
                                    android:id="@+id/cusAccountGmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Gmail"
                                        android:textSize="18sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputGmail"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.6"
                                        android:hint="John@gmail.com"
                                        android:textSize="18sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusDeliveryCount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Delivery Count"
                                        android:textSize="18sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputDeliveryCount"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.6"
                                        android:hint="0"
                                        android:textSize="18sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusMyParcelsCount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Parcels Count"
                                        android:textSize="18sp"
                                        android:gravity="center_vertical"/>
                                    <TextView
                                        android:id="@+id/viewInputcusMyParcelsCount"
                                        android:layout_height="40dp"
                                        android:layout_width="0dp"
                                        android:layout_weight="0.6"
                                        android:hint="0"
                                        android:textSize="18sp"
                                        android:paddingStart="15dp"
                                        android:paddingEnd="15dp"
                                        android:textColorHint="@color/black"
                                        android:inputType="text"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusMyRatings"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="0dp"
                                        android:layout_height="50dp"
                                        android:layout_weight="0.4"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Ratings"
                                        android:textSize="18sp"
                                        android:gravity="center_vertical"/>
                                    <RatingBar
                                        android:id="@+id/ratingBar"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:max="5"
                                        android:rating="4.5"
                                        android:stepSize="0.1"
                                        android:scaleX="0.4"
                                        android:scaleY="0.4"
                                        android:gravity="center_vertical"
                                        android:layout_gravity="center_vertical"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/cusMyComments"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_below="@+id/editableProfile">
                                    <TextView
                                        style="@style/custxtOpenSansromanbold20"
                                        android:layout_width="match_parent"
                                        android:layout_height="50dp"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="Comments"
                                        android:textSize="18sp"
                                        android:gravity="center_vertical"/>
                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/commentsRecyclerView"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:clipToPadding="false"
                                        android:scrollbars="none"
                                        android:layout_gravity="center_vertical"
                                        android:overScrollMode="never"
                                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                        tools:listitem="@layout/comment_item" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>



                <!-- Add a ProgressBar for the loading screen -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:visibility="gone"
                    android:background="#80000000"
                    android:id="@+id/loadingAccManProgressBarLayout">
                    <ProgressBar
                        android:id="@+id/loadingAccManProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_centerInParent="true" />
                </FrameLayout>
            </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>