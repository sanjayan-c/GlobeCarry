<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/searchBarTextFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Transparent View to increase touch area -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"/>

        <SearchView
            android:id="@+id/searchBarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:paddingHorizontal="10dp"
            android:hint="Search"
            android:iconifiedByDefault="false"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_below="@+id/searchBarTextFrame"
        android:id="@+id/MydelRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        tools:listitem="@layout/fragment_my_deliveries_list"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/cusWalletProgressBarLayout"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">
            <ImageView
                android:id="@+id/runningManImageView1"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/running_man_2" />
            <View
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:layout_marginHorizontal="20dp"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:text="Loading Deliveries .."
                style="@style/custxtOpenSansromanbold20" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/cusNothingTextLayout"
        android:layout_centerInParent="true"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Nothing to show"
            style="@style/custxtOpenSansromanbold20" />

    </FrameLayout>
</RelativeLayout>