<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Progress Bar Layout -->
    <FrameLayout
        android:id="@+id/PendingProgressBarLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">

        <ProgressBar
            android:id="@+id/PendingProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/PendingNoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Pendings"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
<androidx.recyclerview.widget.RecyclerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/PendingRecyclerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.PendingParcelFragment"
    android:layout_centerInParent="true"
    tools:listitem="@layout/pending_item" />
</FrameLayout>