<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TravellerDetailView">
    <include
        layout="@layout/custom_toolbar"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/arrowImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="16dp"
            android:src="@drawable/baseline_arrow_circle_left_24"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="0dp"
            android:layout_marginStart="70dp"
            android:layout_marginEnd="120dp"
            android:text="Traveller Detail"
            android:textColor="@color/appcolour"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/TravellerNameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_weight="0.1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Name"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtTravellerName"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/TravellerNumberLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_weight="0.1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="PhoneNo"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtTravellerNumber"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- First Image -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardImage1"
                        android:layout_width="380dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <ImageView
                            android:id="@+id/detailImage1"
                            android:layout_width="380dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/baseline_image_24" />

                    </androidx.cardview.widget.CardView>

                    <!-- Second Image -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardImage2"
                        android:layout_width="380dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <ImageView
                            android:id="@+id/detailImage2"
                            android:layout_width="380dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/baseline_image_24" />

                    </androidx.cardview.widget.CardView>

                    <!-- Third Image -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardImage3"
                        android:layout_width="380dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <ImageView
                            android:id="@+id/detailImage3"
                            android:layout_width="380dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/baseline_image_24" />

                    </androidx.cardview.widget.CardView>
                </LinearLayout>



            <LinearLayout
                android:id="@+id/PassportNoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="0.3"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Pssport No"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtPassportNo"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/FightDateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="0.3"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Flight Date"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtFlightDate"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/DestinationCountryLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_weight="0.1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Destination Country"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtDestinationCountry"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/DestinationCityLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_weight="0.1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Destination City"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtDestinationCity"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/OriginLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <TextView
                    style="@style/custxtOpenSansromanbold20"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="0.3"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Origin"
                    android:textSize="16sp"
                    android:gravity="center_vertical"/>
                <TextView
                    android:id="@+id/txtOrigin"
                    android:layout_height="40dp"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:textSize="16sp"
                    android:hint="-"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/black"
                    android:inputType="text"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAceept"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layout_password"
                    android:text="Accept"
                    android:textSize="16dp"
                    android:layout_marginStart="100dp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/green"
                    android:background="@drawable/edt_background"
                    android:layout_marginTop="20dp" />

                <Button
                    android:id="@+id/btnReject"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layout_password"
                    android:text="Reject"
                    android:textSize="16dp"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red_A200_aa"
                    android:background="@drawable/edt_background"
                    android:layout_marginTop="20dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>