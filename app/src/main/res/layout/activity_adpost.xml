<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <!-- Your other UI elements here -->
    <include
        layout="@layout/custom_toolbar"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/arrowImageView"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="16dp"
            android:src="@drawable/baseline_arrow_circle_left_24"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            />
        <TextView android:ellipsize="end"
            android:id="@+id/Title"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="70dp"
            android:layout_width="wrap_content"
            android:singleLine="true"
            android:text="Parecel to Deliver"
            style="@style/txtPoppinsmedium12_1" tools:text="Parcel To Deliver"/>

    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <ImageView
                android:id="@+id/uploadImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:onClick="onSelectImageClick"
                android:src="@drawable/baseline_image_24" />

            <LinearLayout android:gravity="start"
                android:id="@+id/linearRow003590077380603"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent" android:orientation="horizontal">
                <TextView android:ellipsize="end"
                    android:id="@+id/txt003590077380603"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:singleLine="true"
                    android:text="Urgent :"
                    style="@style/txtPoppinsmedium12_1" tools:text="Urgent :"/>
                <Switch
                    android:id="@+id/switch1"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    />
                <TextView android:ellipsize="end"
                    android:id="@+id/txt"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:singleLine="true"
                    android:text="(+10 % of Total charge)"
                    />

            </LinearLayout>
            <Spinner
                android:id="@+id/category"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:choiceMode="multipleChoice"
                android:entries="@array/categories"
                />

            <EditText
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:hint="Content"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/value"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:hint="Value in Rupees"
                    />
                <EditText
                    android:id="@+id/addweight"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:hint="Weight"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Package Dimension :"
                    android:layout_marginStart="5dp"
                    android:textStyle="bold"
                    android:textSize="17dp"/>
                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:width="70dp"
                    android:id="@+id/length"
                    android:hint="Length"/>
                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:width="70dp"
                    android:id="@+id/width"
                    android:hint="Width"/>
                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:width="70dp"
                    android:id="@+id/height"
                    android:hint="Height"/>

            </LinearLayout>
            <EditText
                android:id="@+id/dlvryAdrs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:hint="Delivery Address"
                />
            <EditText
                android:id="@+id/dlvryAdrs1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:hint="Delivery Address"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/City"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:hint="City"
                    android:layout_marginEnd="5dp"
                    />

                <EditText
                    android:id="@+id/Country"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:hint="Country"
                    />
            </LinearLayout>
            <EditText
                android:id="@+id/receptientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:hint="Recipient Name"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/receptientNumbertxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:hint="Recipient Num"
                    style="@style/txtPoppinsmedium12_1" tools:text="Recipient Number"
                    />
                <EditText
                    android:id="@+id/editTextPhone"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ems="10"
                    android:inputType="phone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/deliverydatetxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:layout_marginStart="5dp"
                    android:text="Desired Delivery Date :"
                    style="@style/txtPoppinsmedium12_1" tools:text="Desired Date" />
                <EditText
                    android:id="@+id/editTextDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ems="10"
                    android:hint="YY/MM/DD"
                    android:inputType="date" />
            </LinearLayout>
            <EditText
                android:id="@+id/specialInstrctns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:hint="Special Instructions"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp">
                <TextView
                    android:id="@+id/chargetxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="2dp"
                    android:hint="Charge"
                    style="@style/txtPoppinsmedium12_1" tools:text="Charge"
                    />
                <TextView
                    android:id="@+id/charge"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:hint="800"
                    style="@style/txtPoppinsmedium12_1" tools:text="800"
                    />
                <TextView
                    android:id="@+id/multiply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:hint="*"
                    style="@style/txtPoppinsmedium12_1" tools:text="*"
                    />
                <TextView
                    android:id="@+id/weightdb"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                style="@style/txtPoppinsmedium12_1" tools:text="Service Charge : 10%"
                android:text="Service Charge : 10%"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:id="@+id/urgencyChrge"
                style="@style/txtPoppinsmedium12_1" tools:text="Urgency Charge : 10%"
                android:text="Urgency Charge : 10%"
                android:visibility="gone" />
            <TextView
                android:id="@+id/TtlChrge"
                style="@style/txtPoppinsmedium12_1"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="Total Charge: $0.00" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnCancel"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="80dp"
                    android:text="Cancel" />
                <Button
                    android:layout_width="wrap_content"
                    android:id="@+id/btnConfirm"
                    android:layout_marginTop="15dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:text="Confirm" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- More UI elements after the ScrollView if needed -->
</LinearLayout>
